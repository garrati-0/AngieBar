<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.waybar-clone" path="/org/gnome/shell/extensions/waybar-clone/">

    <!-- ── Visibility ── -->
    <key name="show-logo" type="b">
      <default>true</default>
      <summary>Show Logo</summary>
    </key>
    <key name="show-workspaces" type="b">
      <default>true</default>
      <summary>Show Workspaces</summary>
    </key>
    <key name="show-net" type="b">
      <default>true</default>
      <summary>Show Internet Speed</summary>
    </key>
    <key name="show-todo" type="b">
      <default>true</default>
      <summary>Show Todo</summary>
    </key>
    <key name="show-cpu" type="b">
      <default>true</default>
      <summary>Show CPU Usage</summary>
    </key>
    <key name="show-ram" type="b">
      <default>true</default>
      <summary>Show RAM Usage</summary>
    </key>
    <key name="show-clock" type="b">
      <default>true</default>
      <summary>Show Clock</summary>
    </key>
    <key name="show-battery" type="b">
      <default>true</default>
      <summary>Show Battery</summary>
    </key>
    <key name="show-quick-settings" type="b">
      <default>true</default>
      <summary>Show Quick Settings</summary>
    </key>
    <key name="show-power" type="b">
      <default>true</default>
      <summary>Show Power Button</summary>
    </key>

    <!-- ── Appearance ── -->
    <key name="custom-color" type="s">
      <default>'#1e1e2e'</default>
      <summary>Island background color (hex or rgb/rgba)</summary>
    </key>
    <key name="island-opacity" type="d">
      <default>0.95</default>
      <summary>Island background opacity (0.0 transparent – 1.0 opaque)</summary>
    </key>
    <key name="cpu-color" type="s">
      <default>'#f38ba8'</default>
      <summary>CPU module color</summary>
    </key>
    <key name="ram-color" type="s">
      <default>'#cba6f7'</default>
      <summary>RAM module color</summary>
    </key>
    <key name="workspace-active-color" type="s">
      <default>'#cba6f7'</default>
      <summary>Active workspace dot color</summary>
    </key>

    <!-- ── Commands ── -->
    <key name="logo-command" type="s">
      <default>'ptyxis -- ollama run llama3.2'</default>
      <summary>Command to run when left-clicking the logo</summary>
    </key>
    <key name="power-command" type="s">
      <default>'gnome-session-quit --power-off'</default>
      <summary>Command to run when clicking the power button</summary>
    </key>
    <key name="logo-icon-path" type="s">
      <default>''</default>
      <summary>Custom logo icon path (leave empty for default)</summary>
    </key>
    <key name="logo-fill-circle" type="b">
      <default>false</default>
      <summary>Fill the logo circle with the image (cover/crop mode)</summary>
    </key>
    <key name="logo-action" type="i">
      <default>1</default>
      <summary>Action for logo left click (0 = command, 1 = menu)</summary>
    </key>
    <key name="logo-menu-folders" type="s">
      <default>'/home/garrati/Documenti,/home/garrati/Scaricati,/home/garrati/Scrivania,/home/garrati/Immagini'</default>
      <summary>Comma separated list of absolute paths for the file menu</summary>
    </key>

  </schema>
</schemalist>
